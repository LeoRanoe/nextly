# ─── Supabase ────────────────────────────────────────────────────────────────
# Project settings → Data API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server-only. Never expose. Used by the seed/migration scripts.
SUPABASE_SECRET_KEY="sb_secret_..."

# ─── Database (Drizzle) ──────────────────────────────────────────────────────
# Transaction pooler (port 6543) for serverless runtime. Requires prepare:false.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres"
# Direct connection (port 5432) for drizzle-kit migrations only.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# ─── Vercel Blob ─────────────────────────────────────────────────────────────
# `vercel env pull` provides this. Note: putImage() needs OIDC credentials,
# which Vercel injects automatically at runtime — a read-write token is NOT
# accepted for optimized uploads. See docs/04-engineering/media-pipeline.md
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
